FROM apache/airflow:2.10.4

USER airflow

# azure-ai-ml lets the DAG submit jobs to the Azure ML workspace.
RUN pip install --no-cache-dir \
    "azure-ai-ml==1.23.0" \
    "azure-identity==1.17.0"

# Bake the cv4 training DAG into the image so no volume mount is required.
COPY dags/ /opt/airflow/dags/

CMD ["standalone"]
