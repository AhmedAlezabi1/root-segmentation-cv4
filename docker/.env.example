# Postgres credentials used by docker-compose for variable substitution.
# POSTGRES_USER and POSTGRES_DB can stay as defaults for local dev;
# POSTGRES_PASSWORD must be set to something - any value works locally,
# but never reuse a real password.
POSTGRES_USER=cv4
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cv4

# Used by cv4.db when running outside Docker (pytest, local CLI, scripts).
# Host port is 5433 because docker-compose maps the container's 5432 to
# 5433 on the host to avoid clashing with a local Postgres install.
# Inside the backend container this variable is set automatically by
# docker-compose and points to "db:5432" instead.
DATABASE_URL=postgresql+psycopg://cv4:changeme@localhost:5433/cv4